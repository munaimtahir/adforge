ADFORGE_ENV=development
ADFORGE_DATA_ROOT=/opt/adforge
ADFORGE_BIND_HOST=127.0.0.1
ADFORGE_BIND_PORT=8089
ADFORGE_SECRET_KEY=CHANGE_ME
# Generate this with: python -m adforge.auth (see deployment documentation).
ADFORGE_ADMIN_PASSWORD_HASH=CHANGE_ME
ADFORGE_IMPORT_ROOT=/opt/adforge/imports
# The database always lives at {ADFORGE_DATA_ROOT}/data/adforge.sqlite3 -- there is
# no separate ADFORGE_DB_PATH setting. Do not add one; environment_doctor.py warns
# if it's present because it would silently be ignored.
ADFORGE_BROWSER_PROFILE_ROOT=/opt/adforge/browser-profiles
ADFORGE_LOG_LEVEL=INFO
ADFORGE_SESSION_HTTPS_ONLY=true
ADFORGE_CLI_TIMEOUT_SECONDS=180
# Do not place provider session cookies or credentials in source control.
