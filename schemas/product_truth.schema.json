{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AdForge Product Truth",
  "type": "object",
  "required": [
    "product_id",
    "product_name",
    "approved_features",
    "prohibited_claims",
    "evidence",
    "last_verified_at"
  ],
  "properties": {
    "product_id": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "package_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "current_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "description": {
      "type": "string"
    },
    "approved_features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prohibited_claims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "known_limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "privacy_claims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "audiences": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "apk_locations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "demo_workflows": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "last_verified_at": {
      "type": "string"
    }
  }
}
